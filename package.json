{
  "name": "@irshad.io/figma-local-mcp",
  "version": "1.5.2",
  "mcpName": "io.github.irshadio/figmcp",
  "description": "Local MCP server for Figma: a development plugin streams the open file over a localhost WebSocket, so design reads never touch the Figma API. Writes Flutter, React or HTML reference code.",
  "keywords": [
    "mcp",
    "mcp-server",
    "figma",
    "figma-plugin",
    "figma-to-code",
    "design-to-code",
    "flutter",
    "react",
    "tailwind",
    "html",
    "model-context-protocol"
  ],
  "author": "irshadio <irshad.kp@icloud.com>",
  "homepage": "https://figmcp.web.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irshadio/figmcp.git"
  },
  "bugs": {
    "url": "https://github.com/irshadio/figmcp/issues"
  },
  "type": "module",
  "bin": {
    "figma-local-mcp": "bin/figma-local-mcp.js"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "plugin",
    "tools",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/figma-local-mcp.js",
    "test": "node --test test/",
    "visual-check": "node tools/visual-check.js",
    "flutter-check": "node tools/flutter-check.js",
    "prepublishOnly": "npm test"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "pngjs": "^7.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "puppeteer-core": "^25.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
